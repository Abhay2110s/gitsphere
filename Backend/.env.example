PORT=5000
SERVER_URL=http://localhost:5000
NODE_ENV=development

MONGODB_URI=mongodb://127.0.0.1:27017/gitsphere
CLIENT_URL=

# Authentication
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRE_DAYS=7


# Email / Nodemailer Configuration (Login Notifications)
EMAIL_SERVICE=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="GitSphere Security" <no-reply@gitsphere.com>

# Notification Auto-Expiration (TTL) in days
NOTIFICATION_TTL_DAYS=30
