# GitSphere Frontend Environment Variables Example

# Base API URL (Relative path '/api/v1' leverages Vite dev proxy to http://localhost:5000)
VITE_API_BASE_URL=/api/v1

# Backend Server Root URL (for WebSocket / Socket.io / Uploaded assets)
VITE_BACKEND_URL=http://localhost:5000
VITE_SOCKET_URL=http://localhost:5000

# Application Configuration
VITE_APP_NAME=GitSphere
VITE_APP_ENV=development
