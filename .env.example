# ==========================================
# GitSphere Vercel Deployment Environment Variables
# ==========================================

# ------------------------------------------
# Backend Serverless Environment Variables
# (Configure in Vercel Project Settings > Environment Variables)
# ------------------------------------------

# MongoDB Connection String (e.g. MongoDB Atlas)
# REQUIRED: Must be an accessible cloud database URI like MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/gitsphere?retryWrites=true&w=majority

# JWT Authentication Secret
# REQUIRED: Random 64-character secret
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRE_DAYS=7

# Allowed Frontend URL (CORS)
# For monorepo deployment on Vercel: can be left unset or your production vercel domain
# For split deployment: https://your-frontend.vercel.app
CLIENT_URL=https://your-production-domain.vercel.app

# Node Environment
NODE_ENV=production

# ------------------------------------------
# Optional: Nodemailer / Email Notifications
# ------------------------------------------
EMAIL_SERVICE=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="GitSphere Security" <no-reply@gitsphere.com>

# ------------------------------------------
# Frontend Environment Variables (Build time)
# (Only needed if deploying Frontend to a different Vercel domain from Backend)
# ------------------------------------------
# Default for monorepo is '/api/v1' (same domain).
# If Backend is deployed separately, set:
# VITE_API_BASE_URL=https://your-backend.vercel.app/api/v1
# VITE_SOCKET_URL=https://your-backend.vercel.app
